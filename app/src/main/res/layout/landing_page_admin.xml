<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hackerBackground"
    tools:context="com.example.passlock.LandingPage">

    <!-- Header Lock Icon -->
    <ImageView
        android:id="@+id/adminLockIcon"
        android:layout_width="95dp"
        android:layout_height="97dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/ic_lock_lock"
        app:tint="@color/hackerGreen" />

    <!-- Header Text (shares ID with user layout for welcome text) -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:text="@string/admin_console_passlock"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/hackerGreen"
        android:typeface="monospace"
        app:layout_constraintTop_toTopOf="@id/adminLockIcon"
        app:layout_constraintBottom_toBottomOf="@id/adminLockIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/adminLockIcon" />

    <!-- Optional subtitle -->
    <TextView
        android:id="@+id/adminSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:text="> AUTH LEVEL: ROOT // MODE: ADMIN"
        android:textSize="14sp"
        android:textColor="@color/hackerMutedGreen"
        android:typeface="monospace"
        app:layout_constraintTop_toBottomOf="@id/adminLockIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="HardcodedText" />

    <!-- BUTTONS SECTION -->
    <LinearLayout
        android:id="@+id/adminButtonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/adminSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/viewUserPasslocksBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VIEW USER PASS LOCKS"
            android:textAllCaps="true"
            android:textColor="@color/hackerAccent"
            android:typeface="monospace"
            android:background="@drawable/hacker_button_outline"
            android:padding="10dp"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/editSuggestedPasslocksBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="EDIT SUGGESTED PASS LOCKS"
            android:textAllCaps="true"
            android:textColor="@color/hackerAccent"
            android:typeface="monospace"
            android:background="@drawable/hacker_button_outline"
            android:padding="10dp"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/compareUserPasslocksBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/compare_user_passlocks"
            android:textAllCaps="true"
            android:textColor="@color/hackerAccent"
            android:typeface="monospace"
            android:background="@drawable/hacker_button_outline"
            android:padding="10dp" />

    </LinearLayout>

    <!-- EXIT Button (Anchored at bottom, shares ID with user layout for logout) -->
    <Button
        android:id="@+id/logoutBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="24dp"
        android:text="@string/exit_admin"
        android:textAllCaps="true"
        android:textColor="@color/hackerAccent"
        android:typeface="monospace"
        android:background="@drawable/hacker_button_outline"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
