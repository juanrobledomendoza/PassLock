<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hackerBackground"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ViewUserPasslocksActivity">

    <!-- Header -->
    <TextView
        android:id="@+id/tv_view_users_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/user_passlocks"
        android:textSize="20sp"
        android:textColor="@color/hackerGreen"
        android:typeface="monospace"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tv_view_users_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_a_user_to_inspect_or_delete"
        android:textSize="14sp"
        android:textColor="@color/hackerMutedGreen"
        android:typeface="monospace"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hackerAccent"
        android:layout_marginBottom="12dp" />

    <!-- Search field -->
    <EditText
        android:id="@+id/et_search_users"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search users"
        android:textColor="@color/hackerAccent"
        android:textColorHint="@color/hackerMutedGreen"
        android:background="@android:color/transparent"
        android:padding="8dp"
        android:layout_marginBottom="8dp" />

    <!-- User list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_users"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="4dp" />

    <!-- Optional back button -->
    <Button
        android:id="@+id/btn_back_from_view_users"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/back_to_admin"
        android:textAllCaps="true"
        android:textColor="@color/hackerAccent"
        android:typeface="monospace"
        android:background="@drawable/hacker_button_outline"
        android:padding="10dp"
        android:layout_marginTop="12dp" />

</LinearLayout>
