<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/hackerBackground"
    tools:context=".MainActivity">

    <!-- Terminal-style banner -->
    <TextView
        android:id="@+id/tv_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/passlock_system_v1_0"
        android:textSize="20sp"
        android:textColor="@color/hackerGreen"
        android:typeface="monospace"
        android:layout_marginBottom="12dp" />

    <!-- Subtitle / description -->
    <TextView
        android:id="@+id/tv_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/secure_encrypt_protect_nyour_digital_vault_awaits"
        android:textSize="14sp"
        android:textColor="@color/hackerMutedGreen"
        android:typeface="monospace"
        android:layout_marginBottom="40dp" />

    <!-- Divider line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/hackerAccent"
        android:layout_marginBottom="40dp" />

    <!-- Main title (stylized) -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/passlock_access"
        android:textSize="28sp"
        android:layout_marginBottom="40dp"
        android:textStyle="bold"
        android:typeface="monospace"
        android:textColor="@color/hackerGreen" />

    <!-- LOGIN BUTTON -->
    <Button
        android:id="@+id/loginButton"
        android:text="@string/enter_system"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/hackerAccent"
        android:textAllCaps="true"
        android:typeface="monospace"
        android:background="@drawable/hacker_button_outline"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <!-- CREATE ACCOUNT BUTTON -->
    <Button
        android:id="@+id/createAccountButton"
        android:text="@string/create_account2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/hackerAccent"
        android:textAllCaps="true"
        android:typeface="monospace"
        android:background="@drawable/hacker_button_outline"
        android:padding="12dp" />

</LinearLayout>
