<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hackerBackground"
    android:padding="16dp"
    tools:context=".CompareUserWalletActivity">

    <TextView
        android:id="@+id/tv_wallet_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="USER WALLET STRENGTH"
        android:textSize="20sp"
        android:textColor="@color/hackerGreen"
        android:textStyle="bold"
        android:typeface="monospace"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_wallet_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Overall grade per user based on all passlocks"
        android:textSize="14sp"
        android:textColor="@color/hackerMutedGreen"
        android:typeface="monospace"
        app:layout_constraintTop_toBottomOf="@id/tv_wallet_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_user_wallets"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tv_wallet_subtitle"
        app:layout_constraintBottom_toTopOf="@id/btn_back_from_compare_wallets"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_back_from_compare_wallets"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="BACK TO ADMIN"
        android:textAllCaps="true"
        android:textColor="@color/hackerAccent"
        android:typeface="monospace"
        android:background="@drawable/hacker_button_outline"
        android:padding="10dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
