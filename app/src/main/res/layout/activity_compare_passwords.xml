<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hackerBackground"
    android:padding="24dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Password A Input -->
        <EditText
            android:id="@+id/inputPasswordA"
            android:hint="Enter Password A"
            android:inputType="textPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/hackerGreen"
            android:textColorHint="@color/hackerMutedGreen"
            android:backgroundTint="@color/hackerAccent"
            android:typeface="monospace" />

        <!-- Password B Input -->
        <EditText
            android:id="@+id/inputPasswordB"
            android:hint="Enter Password B"
            android:inputType="textPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/hackerGreen"
            android:textColorHint="@color/hackerMutedGreen"
            android:backgroundTint="@color/hackerAccent"
            android:typeface="monospace" />

        <!-- Compare Button -->
        <Button
            android:id="@+id/btnComparePasswords"
            android:text="Compare Passwords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/hacker_button_outline"
            android:textColor="@color/hackerAccent"
            android:textAllCaps="true"
            android:typeface="monospace" />

        <!-- Results -->
        <TextView
            android:id="@+id/txtScoreA"
            android:text="Password A Score:"
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/hackerGreen"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/txtScoreB"
            android:text="Password B Score:"
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hackerGreen"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/txtComparisonResult"
            android:text="Comparison Result:"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hackerGreen"
            android:typeface="monospace" />

        <Button
            android:id="@+id/btnBackToHome"
            android:text="Back to Home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/hacker_button_outline"
            android:textColor="@color/hackerAccent"
            android:textAllCaps="true"
            android:typeface="monospace" />

    </LinearLayout>
</ScrollView>