<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hackerBackground">

    <EditText
        android:id="@+id/inputPassword"
        android:hint="@string/enter_password"
        android:inputType="textPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/hackerGreen"
        android:textColorHint="@color/hackerMutedGreen"
        android:backgroundTint="@color/hackerAccent"
        android:typeface="monospace"/>

    <Button
        android:id="@+id/btnTestPassword"
        android:text="@string/test_strength"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/hacker_button_outline"
        android:textColor="@color/hackerAccent"
        android:textAllCaps="true"
        android:typeface="monospace"/>

    <TextView
        android:id="@+id/txtScore"
        android:text="@string/score"
        android:textSize="18sp"
        android:layout_marginTop="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/hackerGreen"
        android:typeface="monospace"/>

    <TextView
        android:id="@+id/txtFeedback"
        android:text="@string/feedback"
        android:textSize="18sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/hackerGreen"
        android:typeface="monospace"/>

    <TextView
        android:id="@+id/txtAiTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="AI Tip: (requires network and API key)"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnBackToLanding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/back_to_landing_page"
        android:layout_marginTop="24dp"
        android:background="@drawable/hacker_button_outline"
        android:textColor="@color/hackerAccent"
        android:textAllCaps="true"
        android:typeface="monospace"/>

</LinearLayout>
